# Copy to .env and fill in. (.env.local also works and overrides .env; empty values there override too.)
# Backend base URL (no trailing slash). Leave empty in development: the Vite dev server then forwards
# /api and /hubs to the backend (API_PROXY_TARGET, default http://localhost:5024), so the app also works
# through an HTTPS tunnel such as ngrok. Set it to the deployed API's URL for production builds.
VITE_API_URL=

# Firebase console -> Project settings -> General -> Your apps -> Web app config.
# These identify the Firebase project; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
